APP_NAME=TaskHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://SERVER_IP:18080
APP_TIMEZONE=Asia/Shanghai

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=MYSQL_SERVER_IP
DB_PORT=3306
DB_DATABASE=taskhub
DB_USERNAME=taskhub
DB_PASSWORD=
DB_TIMEZONE=+08:00

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync

REDIS_CLIENT=phpredis
REDIS_HOST=REDIS_SERVER_IP
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

EXTERNAL_DIRECTORY_CACHE_STORE=redis
EXTERNAL_DIRECTORY_CACHE_TTL=86400

SSO_BASE_URL=
SSO_LOGIN_URL=
SSO_LOGOUT_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SCOPE=
SSO_CALLBACK_PATH=/sso/callback
SSO_TOKEN_PATH=
SSO_USERINFO_PATH=
SSO_USERINFO_METHOD=GET
SSO_TIMEOUT=3
SSO_VERIFY_SSL=true

PAYMENT_ACCOUNT_BASE_URL=
PAYMENT_ACCOUNT_LIST_PATH=
PAYMENT_ACCOUNT_METHOD=GET
PAYMENT_ACCOUNT_TIMEOUT=3
PAYMENT_ACCOUNT_VERIFY_SSL=true
PAYMENT_ACCOUNT_CACHE_KEY=taskhub:payment_accounts

PERSONNEL_BASE_URL=
PERSONNEL_LIST_PATH=
PERSONNEL_METHOD=GET
PERSONNEL_TIMEOUT=3
PERSONNEL_VERIFY_SSL=true
PERSONNEL_CACHE_KEY=taskhub:personnel_users
PERSONNEL_AVATAR_BASE_URL=

FILE_OPERATION_BASE_URL=
FILE_OPERATION_UPLOAD_PATH=/file-operation/file/upload
FILE_OPERATION_DOWNLOAD_URL_PREFIX=
FILE_OPERATION_SERVICE_KEY=
FILE_OPERATION_TIMEOUT=180
FILE_OPERATION_CONNECT_TIMEOUT=10
FILE_OPERATION_VERIFY_SSL=true

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=SMTP_SERVER_IP
MAIL_PORT=25
MAIL_TIMEOUT=10
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
